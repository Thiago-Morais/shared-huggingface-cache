# Set the local directory that will hold your huggingface home
# This path is relative to this docker-compose.yml file and will overwrite the directory at $HF_HOME inside the container
HF_MOUNT=./huggingface
# You can see all other environment variables at https://huggingface.co/docs/huggingface_hub/en/package_reference/environment_variables
HF_HOME=/cache/huggingface
# You can use the $HF_TOKEN variable for token, or create a file at $HUGGINGFACE_MOUNT/token and place your token there (recommended)
# HF_TOKEN=your_token_here
# HF_TOKEN_PATH=$HF_HOME/token
